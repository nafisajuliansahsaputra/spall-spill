# Public application origin
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Supabase public browser/server-session configuration
# Use the new publishable key format (sb_publishable_...) for new projects.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only privileged Supabase key.
# Never prefix this with NEXT_PUBLIC_. Use only for explicitly privileged
# server/background operations that cannot safely run as the caller under RLS.
SUPABASE_SECRET_KEY=

# Provider secrets are added only when their implementation surface is enabled.
# Never commit real values into this file or Git history.
