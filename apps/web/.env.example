# ---------------------------------------------------------------------------
# Public Supabase connection
# ---------------------------------------------------------------------------
# Safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Server-only Supabase elevated credential
# ---------------------------------------------------------------------------
# Production / hosted environments should use the current sb_secret_ key.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Local Supabase development fallback only when a modern secret key is not
# available from the local stack.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Server-only Cloudflare R2 Profile Media storage
# ---------------------------------------------------------------------------
# Dedicated private Profile Media bucket credentials.
# Use a bucket-scoped Object Read & Write token only.
# Never prefix any of these variables with NEXT_PUBLIC_.
R2_S3_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PROFILE_BUCKET=